{
  "name": "blockus-ide-extension",
  "displayName": "blockus IDE Extension",
  "private": true,
  "description": "Browse and install blockus blocks — production-ready React blocks — without leaving your editor.",
  "version": "1.0.4",
  "publisher": "ln-dev",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "AGPL-3.0-only",
  "categories": [
    "AI",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "blockus.setAgent",
        "title": "Set the preferred agent you want to use with blockus",
        "category": "blockus"
      },
      {
        "command": "blockus.openDataPanel",
        "title": "Open blockus Blocks Panel",
        "category": "blockus"
      },
      {
        "command": "blockus.focusApiDataView",
        "title": "Focus blockus Blocks Panel",
        "category": "blockus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "blockus-sidebar",
          "title": "blockus",
          "icon": "./icon.svg"
        }
      ]
    },
    "views": {
      "blockus-sidebar": [
        {
          "type": "webview",
          "id": "blockus.apiDataView",
          "name": "blockus Blocks",
          "icon": "$(rocket)",
          "when": "true"
        }
      ]
    },
    "icons": {
      "blockus-icon": {
        "description": "blockus icon",
        "default": {
          "fontPath": "./stagewise-icons.woff",
          "fontCharacter": "\\E800"
        }
      }
    },
    "configuration": [
      {
        "title": "blockus",
        "type": "object",
        "properties": {
          "blockus.telemetry.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable anonymous usage data collection to help improve the product. No personal data is collected.",
            "tags": [
              "telemetry",
              "usesOnlineServices"
            ],
            "markdownDescription": "Enable anonymous usage data collection to help improve the product. No personal data is collected."
          }
        }
      },
      {
        "title": "blockus",
        "type": "object",
        "properties": {
          "blockus.apiKey": {
            "type": "string",
            "default": "",
            "description": "Your blockus API key (bk_live_…). Get yours at https://blockus.lndevui.com/account/registry-token",
            "markdownDescription": "Your blockus API key (bk_live_…) used to unlock Pro blocks. Get yours at [blockus](https://blockus.lndevui.com/account/registry-token)."
          }
        }
      }
    ]
  },
  "homepage": "https://blockus.lndevui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ln-dev7/blockus-ide-extension.git"
  },
  "bugs": {
    "url": "https://github.com/ln-dev7/blockus-ide-extension/issues"
  },
  "keywords": [
    "blockus",
    "react",
    "blocks",
    "shadcn",
    "tailwindcss",
    "extension",
    "vscode",
    "stagewise-fork"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "run-server": "node ./out/server.js",
    "build": "webpack --mode production --config webpack.config.js"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.15.2",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.2",
    "@yarnpkg/lockfile": "^1.1.0",
    "copy-webpack-plugin": "^13.0.1",
    "dotenv": "^17.2.0",
    "ovsx": "^0.10.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "3.1.2",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.15.1",
    "@stagewise/agent-client": "workspace:*",
    "@stagewise/agent-interface": "workspace:*",
    "@stagewise/agent-runtime-vscode": "workspace:*",
    "@stagewise/extension-toolbar-srpc-contract": "workspace:*",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/yarnpkg__lockfile": "^1.1.9",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "posthog-node": "^4.17.1",
    "ws": "^8.18.3",
    "zod": "3.25.76"
  },
  "turbo": {
    "tasks": {
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "out/**"
        ]
      }
    }
  }
}

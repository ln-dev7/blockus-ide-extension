# Copy this file to `.env` at the repo root: `cp .env.example .env`
#
# Analytics/telemetry is NOT used in blockus-ide-extension.
# Leave POSTHOG_API_KEY empty — the value just needs to exist so the CLI build
# (esbuild `define`) and turbo passthrough resolve to a string.
POSTHOG_API_KEY=

# Optional overrides (sensible defaults already exist in apps/cli/build.ts):
# POSTHOG_HOST=https://eu.i.posthog.com
# STAGEWISE_CONSOLE_URL=https://console.stagewise.io
# API_URL=https://api.stagewise.io
